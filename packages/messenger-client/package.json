{
    "name": "@techspear/messenger-client",
    "version": "1.0.0",
    "description": "Client TypeScript pour envoyer des messages via le système Messenger",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "module": "dist/index.esm.js",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c",
        "build:types": "tsc --emitDeclarationOnly --outDir dist",
        "prepublishOnly": "npm run build",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --config jest.config.ci.js",
        "test:integration": "jest --testPathPattern=integration",
        "test:unit": "jest --testPathIgnorePatterns=integration",
        "lint": "tsc --noEmit",
        "dev": "rollup -c --watch"
    },
    "keywords": [
        "messenger",
        "email",
        "sms",
        "notifications",
        "redis",
        "queue",
        "bullmq",
        "typescript"
    ],
    "author": "TechSpear",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TechSpear-SD/messenger.git",
        "directory": "packages/messenger-client"
    },
    "homepage": "https://github.com/TechSpear-SD/messenger#readme",
    "peerDependencies": {
        "bullmq": "^5.60.0",
        "ioredis": "^5.8.0"
    },
    "dependencies": {
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^11.1.5",
        "@types/jest": "^29.5.8",
        "@types/node": "^20.9.0",
        "jest": "^29.7.0",
        "jest-junit": "^16.0.0",
        "rollup": "^4.5.0",
        "rollup-plugin-dts": "^6.1.0",
        "ts-jest": "^29.1.1",
        "typescript": "^5.2.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
